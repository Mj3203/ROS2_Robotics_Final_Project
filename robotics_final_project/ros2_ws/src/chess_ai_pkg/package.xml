<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>chess_ai_pkg</name>
  <version>0.0.0</version>
  <description>Chess AI: Stockfish engine + python-chess move validation and board state</description>
  <maintainer email="mj3203@gmail.com">mj3203</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>custom_interface</depend>

  <exec_depend>python3-stockfish</exec_depend>
  <exec_depend>python3-chess</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
